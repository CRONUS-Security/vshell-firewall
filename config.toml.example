# 全局配置
[global]
buffer_size = 32768
log_level = "info"
log_file = "./vshell-firewall.log"

# GeoIP 配置
[global.geoip]
enabled = false
database_path = "./GeoLite2-Country.mmdb"
block_regions = ["US", "EU"]

# 时间窗口配置
[global.time_window]
enabled = false
timezone = "UTC"
start_time = "00:00"
end_time = "11:00"

# 监听端口配置 - 可以配置多个
[[listeners]]
name = "listener-8880-9991"
listen_port = ":8080"
backend_addr = "127.0.0.1:8081"
protocol = "tcp"

# 超时配置
[listeners.timeout]
enabled = true                   # 是否启用超时
initial_read = 30                # 初始读取超时 (秒)，0 表示无限制
connect_backend = 5              # 连接后端超时 (秒)，0 表示无限制
